{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "smart",
  // --- performance (max snappiness) ---
  "logLevel": "WARN",
  "autoupdate": "notify",
  "share": "disabled",
  "snapshot": false,
  "formatter": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2
  },
  "tool_output": {
    "max_lines": 400,
    "max_bytes": 24576
  },
  "experimental": {
    "mcp_timeout": 5000
  },
  "plugin": ["cursor-oauth-opencode", "./plugins/cursor-otto.js", "./plugins/image-router.js"],
  "instructions": ["instructions/ai-engineering-system.md"],
  "disabled_providers": ["openai"],
  "provider": {
    // cursor-oauth-opencode reads these knobs from opencode.json (see sibling
    // file). Mirrored here so jsonc remains the source of truth for humans.
    "cursor": {
      "plugin": {
        "cloudIndex": {
          "bootstrapOnLoad": false
        },
        "indexWatcher": {
          "enabled": false
        }
      }
    },
    "cursor-otto": {
      "name": "Cursor Otto",
      "options": {
        "baseURL": "http://localhost:8789/v1",
        "includeUsage": true
      }
    }
  },
  "references": {
    "diffing": {
      "repository": "ahmedragab20/diffing",
      "branch": "main",
      "description": "Use for diffing CLI/MCP contracts, the plan/code review loop, comment lifecycle, and human-AI review workflow conventions"
    }
  },
  "mcp": {
    // Disabled on boot — MCP tool schemas inflate every turn's prompt.
    // Re-enable when doing /diffing review: set enabled true (or opencode mcp).
    "diffing": {
      "type": "local",
      "command": ["diffing", "mcp"],
      "enabled": false,
      "timeout": 5000
    }
  },
  "agent": {
    "smart": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "description": "The smart lead (Smart). Owns design, architecture, debugging, and the TDD bug-reproduction loop. Implements scoped work itself and routes chores (tests/lint/docs/git/memory/compression) directly to Flash workers. CRITICAL: No native vision — any image data goes to the vision agent immediately. STRICT CHORE RULE: Smart never does chores itself.",
      "steps": 65,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "deny",
          "worker": "allow",
          "tests": "allow",
          "lint": "allow",
          "docs": "allow",
          "git": "allow",
          "memory": "allow",
          "terminal-reader": "allow",
          "log-reader": "allow",
          "diff-reader": "allow",
          "vision": "allow",
          "vision-free": "allow",
          "worker-paid": "allow",
          "tests-paid": "allow",
          "lint-paid": "allow",
          "docs-paid": "allow",
          "git-paid": "allow",
          "memory-paid": "allow",
          "terminal-reader-paid": "allow",
          "log-reader-paid": "allow",
          "diff-reader-paid": "allow"
        },
        "diffing_*": "allow"
      }
    },
    "cursor": {
      "mode": "primary",
      "model": "cursor/grok-4.5-fast",
      "description": "Cursor lead (opt-in). Same routing as Smart on Cursor subscription models (model is configurable). Implements scoped work itself and routes chores to Flash workers. CRITICAL: No native vision — any image data goes to the vision agent immediately. STRICT CHORE RULE: never does chores itself.",
      "steps": 65,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "deny",
          "worker": "allow",
          "tests": "allow",
          "lint": "allow",
          "docs": "allow",
          "git": "allow",
          "memory": "allow",
          "terminal-reader": "allow",
          "log-reader": "allow",
          "diff-reader": "allow",
          "vision": "allow",
          "vision-free": "allow",
          "worker-paid": "allow",
          "tests-paid": "allow",
          "lint-paid": "allow",
          "docs-paid": "allow",
          "git-paid": "allow",
          "memory-paid": "allow",
          "terminal-reader-paid": "allow",
          "log-reader-paid": "allow",
          "diff-reader-paid": "allow"
        },
        "diffing_*": "allow"
      }
    },
    "otto": {
      "mode": "primary",
      "model": "cursor-otto/grok-4.5",
      "variant": "high",
      "description": "Otto lead (opt-in). Same routing as Smart on Cursor subscription models via cursor-otto (@otto-assistant bridge). Implements scoped work itself and routes chores to Flash workers. CRITICAL: No native vision — any image data goes to the vision agent immediately. STRICT CHORE RULE: never does chores itself.",
      "steps": 65,
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": {
          "*": "deny",
          "worker": "allow",
          "tests": "allow",
          "lint": "allow",
          "docs": "allow",
          "git": "allow",
          "memory": "allow",
          "terminal-reader": "allow",
          "log-reader": "allow",
          "diff-reader": "allow",
          "vision": "allow",
          "vision-free": "allow",
          "worker-paid": "allow",
          "tests-paid": "allow",
          "lint-paid": "allow",
          "docs-paid": "allow",
          "git-paid": "allow",
          "memory-paid": "allow",
          "terminal-reader-paid": "allow",
          "log-reader-paid": "allow",
          "diff-reader-paid": "allow"
        },
        "diffing_*": "allow"
      }
    },
    "worker": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Low-risk mechanical implementation, boilerplate, CRUD, fixtures, mocks, and simple refactors. Follows the lead's instructions and hands back the result.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "tests": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Writes and updates tests, integration tests, snapshots, fixtures, and mocks. Follows the lead's instructions and hands back the result.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "lint": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Handles formatting, lint, imports, and style without intentional runtime behavior changes. Follows the lead's instructions and hands back the result.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "docs": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Writes README content, markdown docs, comments, and documentation updates. Follows the lead's instructions and hands back the result.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "git": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Writes commit messages, release notes, PR summaries, and git change summaries. Follows the lead's instructions and hands back the result.",
      "steps": 12,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "memory": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Maintains rolling repository memory and refreshes project summaries after significant changes. Follows the lead's instructions and hands back the result.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "terminal-reader": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Compresses large terminal output into errors, warnings, first failure, likely root cause, and relevant files. Hands the compressed packet back to the lead.",
      "steps": 8,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "log-reader": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Compresses logs into repeated exceptions, timestamps, frequencies, and likely failing subsystem. Hands the compressed packet back to the lead.",
      "steps": 8,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "diff-reader": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Compresses large git diffs into changed APIs, risky files, behavior changes, and migration notes. Hands the compressed packet back to the lead.",
      "steps": 8,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "vision": {
      "mode": "subagent",
      "model": "opencode-go/gpt-5.6-luna",
      "description": "Provides vision for all primary leads by describing images as structured markdown. Uses GPT 5.6 Luna (Go bundle). Does not implement, debug, or take actions.",
      "steps": 6,
      "permission": {
        "bash": "allow",
        "external_directory": "allow",
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "vision-free": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/mimo-v2.5-free",
      "description": "Free MiMo V2.5 fallback when GPT 5.6 Luna is unavailable, rate-limited, or over quota. Describes images as structured markdown for the lead.",
      "steps": 6,
      "permission": {
        "bash": "allow",
        "external_directory": "allow",
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "worker-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback for low-risk mechanical implementation when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "tests-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback tests specialist when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "lint-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback lint and formatting specialist when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "docs-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback documentation specialist when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "git-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback git communication specialist when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 12,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "memory-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback repository memory maintainer when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 12,
      "permission": { "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "terminal-reader-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback terminal-output compressor when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 8,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "log-reader-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback log compressor when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 8,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "diff-reader-paid": {
      "mode": "subagent",
      "hidden": true,
      "model": "opencode-go/deepseek-v4-flash",
      "description": "Paid fallback diff compressor when DeepSeek V4 Flash Free is unavailable, rate-limited, or over quota.",
      "steps": 8,
      "permission": { "edit": "deny", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    }
  }
}